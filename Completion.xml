<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- The viewed zone's completion in the world map's top-left corner: bare text, no box. -->
	<Button name="LegacyHereZoneOverlayTemplate" mixin="LegacyHereZoneOverlayMixin" frameStrata="HIGH" virtual="true">
		<Size x="1" y="1"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Shade">
					<Color r="1" g="1" b="1"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="-12" y="8"/>
						<Anchor point="BOTTOMRIGHT" x="48" y="-8"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Title" inherits="GameFontNormalLarge" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
					<Shadow>
						<Offset x="1" y="-1"/>
						<Color r="0" g="0" b="0"/>
					</Shadow>
				</FontString>
				<FontString parentKey="Counts" inherits="GameFontHighlight" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Title" relativePoint="BOTTOMLEFT" x="0" y="-12"/>
					</Anchors>
					<Shadow>
						<Offset x="1" y="-1"/>
						<Color r="0" g="0" b="0"/>
					</Shadow>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<!-- A zone's completion percent on a continent map, under its Legacy count. No mouse, so clicks reach the map. -->
	<Frame name="LegacyHereZonePercentPinTemplate" mixin="LegacyHereZonePercentPinMixin" virtual="true">
		<Size x="40" y="14"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall">
					<Anchors>
						<Anchor point="TOP" y="-10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
