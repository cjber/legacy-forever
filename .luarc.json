{
  "runtime.version": "Lua 5.1",
  "workspace.library": [
    ".types/vscode-wow-api/Annotations/Core",
    ".types/vscode-wow-api/Annotations/FrameXML"
  ],
  "workspace.ignoreDir": [
    ".types",
    "tests",
    "tools",
    ".sift",
    ".release",
    ".claude"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.libraryFiles": "Disable",
  "diagnostics.neededFileStatus": {
    "param-type-mismatch": "Any",
    "redundant-parameter": "Any",
    "missing-parameter": "Any",
    "undefined-field": "Any",
    "undefined-global": "Any",
    "need-check-nil": "Any",
    "assign-type-mismatch": "Any",
    "return-type-mismatch": "Any",
    "cast-local-type": "Any",
    "redundant-return-value": "Any",
    "missing-return": "Any",
    "unused-local": "Any",
    "unused-function": "Any",
    "unused-vararg": "Any",
    "unused-label": "Any",
    "trailing-space": "Any",
    "redundant-return": "Any",
    "empty-block": "Any",
    "code-after-break": "Any",
    "unreachable-code": "Any",
    "redefined-local": "Any",
    "cast-type-mismatch": "Any",
    "inject-field": "Any",
    "missing-fields": "Any",
    "missing-return-value": "Any"
  },
  "diagnostics.severity": {
    "unused-local": "Information",
    "unused-function": "Information",
    "unused-vararg": "Information",
    "unused-label": "Information",
    "trailing-space": "Information",
    "redundant-return": "Information",
    "empty-block": "Information",
    "code-after-break": "Information",
    "unreachable-code": "Information",
    "redefined-local": "Information"
  }
}
