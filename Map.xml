<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- An unfinished Legacy objective on the world map. Mouse motion only, so clicks still reach the map. -->
	<Frame name="LegacyHerePinTemplate" mixin="LegacyHerePinMixin" enableMouseMotion="true" virtual="true">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" atlas="UI-Legacy-Points-icon-c60">
					<Size x="11" y="16"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Count" inherits="NumberFontNormalSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="-2" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture atlas="UI-Legacy-Points-icon-c60" alphaMode="ADD" alpha="0.5">
					<Size x="11" y="16"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!-- Styled after WorldMapTrackingPinButtonTemplate so it reads as part of the map's own button column. -->
	<DropdownButton name="LegacyHereMapButtonTemplate" frameStrata="HIGH" mixin="LegacyHereMapButtonMixin" virtual="true">
		<Size x="32" y="32"/>
		<KeyValues>
			<KeyValue key="menuPoint" type="string" value="TOPRIGHT"/>
			<KeyValue key="menuRelativePoint" type="string" value="BOTTOMRIGHT"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" file="Interface\Minimap\UI-Minimap-Background">
					<Size x="25" y="25"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-4"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" atlas="UI-Legacy-Points-icon-c60">
					<Size x="13" y="19"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Background"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="1">
				<Texture parentKey="Border" file="Interface\Minimap\MiniMap-TrackingBorder">
					<Size x="54" y="54"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="2">
				<FontString parentKey="Count" inherits="NumberFontNormalSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-4" y="5"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</DropdownButton>
</Ui>
