package-as: LegacyForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

# The packager already drops every dot-prefixed path (release.sh), so only the rest is listed.
ignore:
  - AGENTS.md
  - forever-core
  - tools
  - types
  - tests
  - docs
  - Locales/phrases.txt
  - Locales/README.md
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  - .agents
  - .claude

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - shortest-path-forever
  - questiedb
  - questie
  - atlasloot-forever

# ForeverCore ships inside this zip as its own folder, at the release tools/forever-core.txt pins, so an
# update brings it along: players who updated did not get it as a required dependency.
externals:
  ForeverCore: https://github.com/cjber/forever-core/releases/download/v1.15.3/ForeverCore-v1.15.3-forever.zip

move-folders:
  LegacyForever/ForeverCore: ForeverCore

# The CurseForge app must not install or remove that folder on its own (cjber/forever-core#922), so ForeverCore is listed
# as an embedded library: linked on the project page, never installed as a required dependency. The addon also
# carries the pinned core under Libs/ForeverCore and runs with the standalone folder turned off or removed.
embedded-libraries:
  - forevercore
