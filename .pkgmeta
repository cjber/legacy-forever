package-as: LegacyForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - AGENTS.md
  - .release-notes.md
  - tools
  - types
  - .types
  - tests
  - docs
  - media/icon.svg
  - media/icon-400.png
  - .luacheckrc
  - .luarc.json
  - stylua.toml
  - ruff.toml
  - .agents
