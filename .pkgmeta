package-as: LegacyForever

required-dependencies:
  - forevercore

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

# The packager already drops every dot-prefixed path (release.sh), so only the rest is listed.
ignore:
  - AGENTS.md
  - forever-core
  - tools
  - types
  - tests
  - docs
  - Locales/phrases.txt
  - Locales/README.md
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  - .agents
  - .claude

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - shortest-path-forever
  - questiedb
  - questie
  - atlasloot-forever
